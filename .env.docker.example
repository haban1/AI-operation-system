# Local development only. Generate .env.docker with scripts/init-docker-dev.mjs.
AUTH_ENABLED=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123
SESSION_SECRET=replace-with-random-secret
AGENT_SHARED_TOKEN=replace-with-random-secret
ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
AGENT_ALLOWED_ORIGINS=http://127.0.0.1:3100,http://localhost:3100
QWEN_MODE=mock
QWEN_API_KEY=
WECOM_WEBHOOK_URL=
RAG_AUTH_ENABLED=true
RAG_TOKEN=replace-with-shared-rag-token
RAG_BEARER_TOKEN=replace-with-shared-rag-token
RAG_RETRIEVAL_BEARER_TOKEN=replace-with-random-secret
TIANHE_ADMIN_TOKEN=replace-with-random-secret
TIANHE_MODEL_TOKEN=replace-with-random-secret
RAG_GENERATION_PROVIDER=deterministic
RAG_LLM_BASE_URL=
RAG_LLM_API_KEY=
RAG_QUERY_REWRITE_ENABLED=false
RAG_DEEP_AGENT_ENABLED=false
RAG_FASTEMBED_LOCAL_FILES_ONLY=true
RAG_ALLOW_MODEL_FALLBACK=false
