    "react-dom": "19.2.8",
    "remotion": "4.0.520",
    "zod": "4.4.3",
    "@remotion/media": "4.0.520",
    "@remotion/captions": "4.0.520"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "typescript": "5.9.3"
  }
