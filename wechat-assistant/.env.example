SECRET_KEY=change-me-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

DATABASE_URL=postgresql+psycopg://agent:agent@postgres:5432/agent

LLM_ENABLED=true
# Tianhe Compose enables this and provides the shared internal token.
TIANHE_AI_ENABLED=false
TIANHE_AI_BASE_URL=http://web:3100/api/model/v1
TIANHE_MODEL_TOKEN=
# 可选：自定义机器人的角色与语气；留在代码默认值即可，不用于填写业务事实。
# ASSISTANT_ROLE_PROMPT=你是课程客服智能助教，帮助用户了解课程，表达简洁、自然、友好。
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DASHSCOPE_API_KEY=
DASHSCOPE_CHAT_MODEL=qwen-plus
# 可选：聊天和 Embedding 使用不同服务时单独配置；两项都留空则沿用上面的 URL 和 Key
DASHSCOPE_EMBEDDING_BASE_URL=
DASHSCOPE_EMBEDDING_API_KEY=
DASHSCOPE_EMBEDDING_MODEL=text-embedding-v4
DASHSCOPE_EMBEDDING_DIMENSIONS=1024
DASHSCOPE_EMBEDDING_BATCH_SIZE=10
LLM_TIMEOUT_SECONDS=20
# 每轮原生工具调用的最大数量；模型服务需要支持 tools/tool_calls
LLM_MAX_QUESTIONS=5
# 单条用户消息最多执行的工具轮数和总调用数量；达到上限后只生成最终回复
LLM_MAX_TOOL_ROUNDS=3
LLM_MAX_TOOL_CALLS=8
# 多轮工具结果可能需要更长的模型处理时间；首次请求仍使用 LLM_TIMEOUT_SECONDS
LLM_TOOL_FOLLOWUP_TIMEOUT_SECONDS=45
QUERY_REWRITE_ENABLED=true
QUERY_REWRITE_HISTORY_TURNS=6
# 兼容旧配置，原生工具调用流程不再生成同义检索变体
QUERY_REWRITE_MAX_VARIANTS=2
QUERY_REWRITE_FUSION_BONUS=0.02
QUERY_REWRITE_VERSION=faq-query-rewrite-v1

SHORT_TERM_MEMORY_TURNS=30
# 文档知识库：向量服务不可用时自动使用关键词检索
DOCUMENT_MAX_UPLOAD_MB=20
DOCUMENT_EMBEDDING_ENABLED=true
DOCUMENT_RETRIEVAL_TOP_K=6
DOCUMENT_EMBEDDING_MIN_SIMILARITY=0.45

# 以下 FAQ / INTENT 参数仅兼容历史模块，不控制当前文档检索
FAQ_EMBEDDING_ENABLED=true
FAQ_EMBEDDING_MIN_SIMILARITY=0.58
FAQ_EMBEDDING_ACCEPT_THRESHOLD=0.62
FAQ_EMBEDDING_MARGIN_THRESHOLD=0.08
FAQ_EMBEDDING_HIGH_RISK_ACCEPT_THRESHOLD=0.72
FAQ_EMBEDDING_HIGH_RISK_MARGIN_THRESHOLD=0.12
FAQ_GROUNDED_GENERATION_ENABLED=true
FAQ_GROUNDED_ANSWER_MAX_CHARS=800
FAQ_MATCH_THRESHOLD=0.62
FAQ_ACCEPT_THRESHOLD=0.78
FAQ_CLARIFY_THRESHOLD=0.58
FAQ_MARGIN_THRESHOLD=0.12
FAQ_HIGH_RISK_ACCEPT_THRESHOLD=0.88
FAQ_HIGH_RISK_MARGIN_THRESHOLD=0.18
FAQ_CANDIDATE_LIMIT=3
FAQ_SEMANTIC_CANDIDATE_LIMIT=20
FAQ_SEMANTIC_ACCEPT_THRESHOLD=0.78
FAQ_SEMANTIC_HIGH_RISK_ACCEPT_THRESHOLD=0.90
FAQ_FACT_CANDIDATE_LIMIT=10
FAQ_FACT_ANSWER_LIMIT=5
FAQ_FACT_MIN_SIMILARITY=0.42
FAQ_FACT_RELATIVE_MARGIN=0.12
FAQ_RRF_ENABLED=true
FAQ_RRF_K=60
FAQ_RRF_TEXT_WEIGHT=1.0
FAQ_RRF_VECTOR_WEIGHT=1.0
FAQ_RRF_POOL_LIMIT=20
INTENT_COURSE_RECALL_THRESHOLD=0.42
INTENT_COURSE_ACCEPT_THRESHOLD=0.78
INTENT_COURSE_MARGIN_THRESHOLD=0.12
INTENT_TEXT_MIN_SIMILARITY=0.42
INTENT_EMBEDDING_MIN_SIMILARITY=0.58
INTENT_ACCEPT_THRESHOLD=0.72
INTENT_CLARIFY_THRESHOLD=0.55
INTENT_MARGIN_THRESHOLD=0.08
INTENT_SEMANTIC_ACCEPT_THRESHOLD=0.78
INTENT_CANDIDATE_LIMIT=5
INTENT_CANDIDATE_POOL_LIMIT=20
INTENT_RRF_K=60
INTENT_RRF_TEXT_WEIGHT=1.0
INTENT_RRF_VECTOR_WEIGHT=1.0
INTENT_CONSENSUS_BONUS=0.04
FAQ_ROUTER_VERSION=faq-router-v1
FAQ_TAXONOMY_VERSION=faq-taxonomy-v3

WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
WECOM_KF_TOKEN=
WECOM_KF_ENCODING_AES_KEY=
WECOM_KF_OPEN_KFID=
WECOM_KF_ACCOUNT_NAME=
# 留空时转入待接入池；填写企业微信成员 userid 时直接转给该接待人
WECOM_KF_HANDOFF_SERVICER_USERID=
WECOM_KF_POLL_ENABLED=true
WECOM_KF_POLL_INTERVAL_SECONDS=5

# wechat-robot-client 独立服务地址。FastAPI 在 Docker 中、客户端在 Windows 主机时可使用：
# http://host.docker.internal:9001
WECHAT_ROBOT_BASE_URL=http://127.0.0.1:9001
# 机器人下载知识库上传图片时使用的 FastAPI 地址。
# Docker Compose 部署会自动覆盖为 http://customer-service-api:8000
WECHAT_ROBOT_MEDIA_BASE_URL=http://127.0.0.1:8000
# 可供反向代理验证调用方；wechat-robot-client 本身当前未内置 API 鉴权
WECHAT_ROBOT_API_AUTHORIZATION=
# 在 wechat-robot-client 的 webhook_headers 中配置同值的 X-Webhook-Token
WECHAT_ROBOT_WEBHOOK_SECRET=
WECHAT_ROBOT_REQUEST_TIMEOUT_SECONDS=30
WECHAT_ROBOT_AUTO_REPLY_ENABLED=true
# off / mention / all；建议保持 mention，避免机器人回复群内每条消息
WECHAT_ROBOT_GROUP_REPLY_MODE=mention
WECHAT_ROBOT_GREETING_ENABLED=true
WECHAT_ROBOT_GREETING_TEXT=你好，我是课程客服助手。请问有什么可以帮你？
WECHAT_ROBOT_HANDOFF_MESSAGE=已为你转接人工客服，请稍候。
WECHAT_ROBOT_HANDOFF_AUTO_RESUME_HOURS=24
WECHAT_ROBOT_MASS_SEND_MAX_RECIPIENTS=50
WECHAT_ROBOT_BROADCAST_MAX_RECIPIENTS=500
WECHAT_ROBOT_BROADCAST_INTERVAL_SECONDS=0.8
