# Copy this file to .env before starting the local WeChat robot stack.
# Replace every value below with a private value for the target machine.
ROBOT_SECRET_KEY=replace-with-at-least-32-random-characters
SESSION_SECRET=replace-with-a-random-session-secret
LOGIN_TOKEN=replace-with-a-private-admin-login-token
SLIDER_TOKEN=replace-with-a-current-slider-service-token

# Optional image registry override.
REGISTRY=docker.io
